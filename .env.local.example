APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8188

DB_CONNECTION=mysql
DB_HOST=sqlproxy
DB_PORT=6033
DB_DATABASE=veltro_local
DB_USERNAME=veltro_app
DB_PASSWORD=change-me

FILESYSTEM_DISK=public
SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb
MAIL_MAILER=log

REVERB_HOST=svveltroreverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# APP_KEY y REVERB_APP_ID/KEY/SECRET se leen desde ../veltro/.env.
