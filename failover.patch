 listen mysql_slave
     bind *:6032
     mode tcp
-    server slave 192.168.20.40:3306
+    option mysql-check user haproxy_check
+    server slave 192.168.20.40:3306 check inter 5s fall 3 rise 2
+
+# Página de estado - permite ver en vivo si HAProxy considera Up o Down
+# a cada backend (clave para detectar la caída del Master)
+listen stats
+    bind *:8404
+    mode http
+    stats enable
+    stats uri /stats
+    stats refresh 10s
+    stats auth admin:admin
 
